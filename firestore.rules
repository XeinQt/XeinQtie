rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public visit counter. Anyone may read it, and anyone may bump it by
    // exactly one — no arbitrary values, no other fields, no deletes.
    match /stats/pageViews {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
